# 로컬에서 Pages Function 을 실행할 때 사용하는 서버 측 환경 변수 예시.
# 이 파일을 .dev.vars 로 복사한 뒤 실제 키를 채워 넣는다. (.dev.vars 는 커밋 대상이 아니다)
#
#   npm run build
#   npx wrangler pages dev build
#
# 운영 환경에서는 Cloudflare Pages > Settings > Environment variables 에
# GEMINI_API_KEY 를 Secret 타입으로 등록한다.

GEMINI_API_KEY=your_gemini_api_key_here
